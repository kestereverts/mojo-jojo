{
  "name": "@mojo-jojo/bot",
  "version": "0.1.0",
  "description": "Modular, RxJS-first IRC bot framework built on @mojo-jojo/irc-client.",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./modules": "./src/modules/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mojo-jojo/irc-client": "workspace:*",
    "rxjs": "^7.8.0"
  }
}
