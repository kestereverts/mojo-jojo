{
  "name": "@mojo-jojo/ai",
  "version": "0.1.0",
  "description": "AI brain for mojo-jojo: provider-agnostic agent loop, event-sourced context, and the mojo-ai bot module.",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mojo-ai": "./src/mojo-ai.ts"
