    "@ai-sdk/openai": "^4.0.7",
    "@mojo-jojo/bot": "workspace:*",
    "@mojo-jojo/irc-client": "workspace:*",
    "ai": "^7",
    "rxjs": "^7.8.0",
    "zod": "^4"
